{
  "experiment_name": "aug_b_full",
  "seed": 42,
  "device": "cpu",
  "image_size": 256,
  "batch_size": 4,
  "num_workers": 0,
  "epochs": 10,
  "augmentation": "full",
  "model": {
    "name": "unet",
    "in_channels": 3,
    "out_channels": 1,
    "features": [
      16,
      32,
      64,
      128
    ]
  },
  "loss": {
    "name": "BCEDiceLoss",
    "bce_weight": 0.5,
    "dice_weight": 0.5
  },
  "optimizer": {
    "name": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "name": "plateau",
    "mode": "max",
    "factor": 0.5,
    "patience": 2,
    "min_lr": 1e-06
  },
  "threshold": 0.5
}